# Copy this file to .env and fill in your values.

# Flask secret key — change this to a long random string in production
SECRET_KEY=your-secret-key-here

# Supabase PostgreSQL connection — use the Session pooler hostname from:
# Supabase dashboard → Project Settings → Database → Connection pooling → Session mode
DB_HOST=aws-0-[region].pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[your-project-ref]
DB_PASSWORD=your-password-here
DB_SSLMODE=disable

# Google OAuth (optional — leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
